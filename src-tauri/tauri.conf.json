{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hyperion",
  "version": "1.0.3",
  "identifier": "com.hyperion.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hyperion",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5MEE1MzM4NDQzMjI0ODUKUldTRkpESkVPRk1LU1NpSnJSbmZNTUc2RUV2WVl1M0VxM0JxSVF0TlovV0dYaDQ5bHlxRzBPcEsK",
      "endpoints": [
        "https://hyperion-updater.rainfalls.workers.dev/latest.json"
      ]
    }
  }
}
