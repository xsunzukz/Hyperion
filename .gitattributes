# Normalise line endings in the repository; keep binaries untouched.
* text=auto eol=lf

*.rs    text eol=lf
*.toml  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.ps1   text eol=crlf

# Binaries
*.png   binary
*.ico   binary
*.icns  binary
*.webp  binary
*.woff  binary
*.woff2 binary

# Lockfiles: merge-friendly, generated by tooling
package-lock.json merge=binary
src-tauri/Cargo.lock merge=binary
